<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- nuget metadata -->
    <Authors>Christophe CHATEAU</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Supervises npm development servers and publishes static SPA assets with SimpleW.</Description>
    <PackageTags>simplew;npm;spa;frontend;development;publishing</PackageTags>
    <PackageProjectUrl>https://simplew.net</PackageProjectUrl>
    <PackageIcon>logo-transparent.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Stratdev3/SimpleW</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- versioning -->
    <AssemblyVersion>26.1.0</AssemblyVersion>
    <FileVersion>26.1.0</FileVersion>
    <Version>26.1.0</Version>

    <!-- build options -->
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- ci/cd -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>

    <!-- debug options-->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- no useless ref -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SimpleWProjectPath Condition="'$(SimpleWProjectPath)' == ''">$(MSBuildThisFileDirectory)..\..\SimpleW\SimpleW.csproj</SimpleWProjectPath>

  </PropertyGroup>

  <!-- use for dotnet build -->
  <ItemGroup Condition="'$(UseLocalSimpleW)' == 'true'">
    <ProjectReference Include="$(SimpleWProjectPath)" />
  </ItemGroup>

  <!-- use for dotnet package (so all packages must follow the same "Major.Minor" version -->
  <ItemGroup Condition="'$(UseLocalSimpleW)' != 'true'">
    <PackageReference Include="SimpleW" Version="$(SimpleWCompatVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="logo-transparent.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\SimpleW.Helper.NpmTooling.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive\SimpleW.Helper.NpmTooling.targets" Pack="true" PackagePath="buildTransitive/" />
    <EmbeddedResource Include="Internal\supervisor.cjs" LogicalName="SimpleW.Helper.NpmTooling.supervisor.cjs" />
  </ItemGroup>

</Project>
